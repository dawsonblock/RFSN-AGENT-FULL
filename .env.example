# RFSN Agent — environment variables
# Copy to .env and fill in your values.

# Required: DeepSeek API key for LLM service
DEEPSEEK_API_KEY=

# Optional: override model (default: deepseek-reasoner)
# DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: deterministic seed (default: 1)
# RFSN_SEED=1

# Optional: service-to-service auth token
# (leave blank to disable auth)
# RFSN_SERVICE_TOKEN=

# Optional: fixed timestamp for ledger determinism
# LEDGER_FIXED_TS=1.0

# Optional: blessed sandbox image tag
# BLESSED_IMAGE=rfsn-blessed:0.2

# Optional: host data directory for Docker mounts
# HOST_DATA_DIR=${PWD}/data
