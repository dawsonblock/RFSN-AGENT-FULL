# RFSN Agent — environment variables
# Copy to .env and fill in your values.

# Required: DeepSeek API key for LLM service
DEEPSEEK_API_KEY=

# Optional: override model (default: deepseek-reasoner)
# DEEPSEEK_MODEL=deepseek-reasoner
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: deterministic seed (default: 1)
# RFSN_SEED=1

# Optional: service-to-service auth token
# Required unless RFSN_DEV_MODE=1.
# RFSN_SERVICE_TOKEN=change-me

# Optional: fixed timestamp for ledger determinism
# LEDGER_FIXED_TS=1.0

# Optional: blessed sandbox image ref.
# In strict mode use a digest-pinned ref.
# BLESSED_IMAGE=rfsn-blessed@sha256:208a2c2dac42ed9b3ca023b30cd815518070930274592844511aa34de21b6360
# RFSN_STRICT_IMAGE_DIGEST=1

# Optional: host data directory for Docker mounts
# HOST_DATA_DIR=${PWD}/data

# Optional: minimum tier required for network-enabled steps
# (e.g., ensure_deps). Default is 2.
# RFSN_NETWORK_MIN_TIER=2

# Optional: executor artifact/output safety caps.
# RFSN_MAX_ARTIFACT_DIR_BYTES=1000000000
# RFSN_MAX_ARTIFACT_DELTA_BYTES=200000000
